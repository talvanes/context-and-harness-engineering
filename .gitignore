.manus/
.manus-jobs/
.claude/
.codex/
.agent/
local/
private/
transcripts/
*.local
*.local.*

# Python environments, caches, and coverage.
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
