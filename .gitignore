tests/stress/evidence/
artifacts/
outputs/
dist/
build/
*.log
*.tmp
*.bak
*.zip
*.skill
node_modules/

# Editors and operating systems.
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Ignore rules are not secret scanning and do not untrack existing files.
# Any .env.example/.env.sample must contain placeholders only.
